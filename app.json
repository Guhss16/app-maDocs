{
  "expo": {
    "name": "maDocs",
    "slug": "maDocs",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "madocs",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon-App.png",
    "android": {
      "package": "com.gustavosamadello.madocs",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-App.png",
        "backgroundColor": "#3E5DF9"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E5DF9"
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "612cd9de-28ef-4c9c-a933-a27c21024afe"
      }
    }
  }
}
